{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YourAnonELF/traceon-replay/blob/main/schemas/fixture.schema.json",
  "title": "Traceon fixture (traceon.fixture/v1)",
  "$defs": {
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "kind": {
          "enum": [
            "measured",
            "estimated"
          ],
          "title": "Kind",
          "type": "string"
        },
        "price_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Source"
        }
      },
      "required": [
        "amount",
        "kind"
      ],
      "title": "Cost",
      "type": "object"
    },
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "python": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "traceon_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceon Version"
        },
        "adapters": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Adapters",
          "type": "object"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "stack": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stack"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "span",
            "tool",
            "model",
            "value"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "error",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "side_effect": {
          "default": false,
          "title": "Side Effect",
          "type": "boolean"
        },
        "call_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Key"
        },
        "request": {
          "$ref": "#/$defs/Payload"
        },
        "response": {
          "$ref": "#/$defs/Payload"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "kind",
        "name",
        "started_at"
      ],
      "title": "Event",
      "type": "object"
    },
    "Payload": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "captured",
            "not_captured",
            "redacted",
            "hash_only"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "redacted_paths": {
          "items": {
            "type": "string"
          },
          "title": "Redacted Paths",
          "type": "array"
        }
      },
      "required": [
        "state"
      ],
      "title": "Payload",
      "type": "object"
    },
    "RedactionInfo": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "default": "default",
          "title": "Policy Id",
          "type": "string"
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        },
        "fields_omitted": {
          "items": {
            "type": "string"
          },
          "title": "Fields Omitted",
          "type": "array"
        }
      },
      "title": "RedactionInfo",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cost"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "traceon.fixture/v1",
      "default": "traceon.fixture/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "fixture_id": {
      "title": "Fixture Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "name": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "source": {
      "default": "traceon",
      "enum": [
        "traceon",
        "langfuse"
      ],
      "title": "Source",
      "type": "string"
    },
    "mode": {
      "default": "record",
      "enum": [
        "record",
        "replay"
      ],
      "title": "Mode",
      "type": "string"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "error",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "redaction": {
      "$ref": "#/$defs/RedactionInfo"
    },
    "input": {
      "$ref": "#/$defs/Payload"
    },
    "output": {
      "$ref": "#/$defs/Payload"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "fixture_id",
    "run_id",
    "name",
    "created_at"
  ],
  "type": "object"
}
